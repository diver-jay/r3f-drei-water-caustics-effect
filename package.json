{
  "name": "react-three-water-caustics",
  "version": "0.1.0",
  "description": "Water caustics simulation for React Three Fiber with interactive ripples and world-space projection",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diver-jay/react-three-water-caustics.git"
  },
  "homepage": "https://github.com/diver-jay/react-three-water-caustics#readme",
  "bugs": {
    "url": "https://github.com/diver-jay/react-three-water-caustics/issues"
  },
  "keywords": [
    "react",
    "three",
    "threejs",
    "react-three-fiber",
    "r3f",
    "water",
    "caustics",
    "webgl",
    "shaders"
  ],
  "author": "diver-J",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite.examples.config.js",
    "build": "tsup",
    "build:demo": "vite build --config vite.examples.config.js",
    "preview": "vite preview --config vite.examples.config.js",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.150",
    "@react-three/fiber": ">=8"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "postprocessing": "^6.36.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0",
    "three-custom-shader-material": "^6.4.0",
    "three-stdlib": "^2.35.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.2.2"
  }
}
